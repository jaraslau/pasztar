FROM python:3.12-slim AS builder

ENV POETRY_VERSION=1.8.4 \
    POETRY_VIRTUALENVS_CREATE=false

WORKDIR /srv/pasztar/backend

RUN pip install --no-cache-dir "poetry==$POETRY_VERSION"

COPY pasztar/backend/pyproject.toml pasztar/backend/poetry.lock ./
COPY pasztar/backend/src ./src

RUN poetry install --only main --no-interaction --no-ansi


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /srv/pasztar/backend

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

RUN groupadd -r app && useradd -r -g app app

COPY --chown=app:app pasztar/backend/src ./src
COPY --chown=app:app pasztar/backend/migrations ./migrations
COPY --chown=app:app pasztar/backend/alembic.ini pasztar/backend/entrypoint.sh ./

RUN chmod +x entrypoint.sh

USER app

ENTRYPOINT ["./entrypoint.sh"]
